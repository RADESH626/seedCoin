  {
    "id": "1776543100000",
    "title": "Idempotent Incremental Migration (v6 Force)",
    "type": "bugfix",
    "context": {
      "what": "Fixed a broken migration by forcing v6 and using per-column try-catch blocks.",
      "why": "The v5 migration failed halfway due to a duplicate column but still bumped the version, leaving users with a broken schema.",
      "where": "src/database/index.ts",
      "learned": "Migrations must be idempotent. Never bump the version if any part of the migration fails, OR implement per-column existence checks to avoid stopping on 'duplicate column' errors."
    },
    "tags": ["sql", "sqlite", "migration", "bugfix"]
  }
