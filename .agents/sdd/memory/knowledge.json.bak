  },
  {
    "id": "1713509820000",
    "title": "Windows Path Length (MAX_PATH) Build Fix",
    "type": "bugfix",
    "context": {
      "what": "Redirected native build (.cxx) and build cache to shorter root-level paths (D:/b/sc/).",
      "why": "Ninja build fails on Windows if paths exceed 260 chars (common in RN New Arch).",
      "where": "android/app/build.gradle, android/local.properties",
      "learned": "Surgically redirecting 'externalNativeBuild.cmake.buildStagingDirectory' is safer than global 'buildDir' because it avoids breaking Expo autolinking."
    },
    "tags": ["android", "build", "windows", "native", "bugfix"]
  },
