    "id": "1776543000000",
    "title": "Environment-Safe Notification Service",
    "type": "architecture",
    "context": {
      "what": "Implemented a wrapper service for notifications that uses dynamic imports and environment detection.",
      "why": "expo-notifications (SDK 54) crashes on import in Expo Go (Android). Dynamic import prevents this crash.",
      "where": "NotificationService.ts, app/_layout.tsx, SchedulerService.ts",
      "learned": "Modules with side-effects on import (like native event emitters) must be loaded dynamically if they are incompatible with Expo Go."
    },
